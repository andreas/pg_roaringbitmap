-- Empty bitmaps (no bits set)
select sources, rb_to_array(members) from rb_kmerge_groups(ARRAY[
  rb_build(ARRAY[]::integer[]),
  rb_build(ARRAY[1,2]),
  rb_build(ARRAY[]::integer[])
]);
 sources | rb_to_array 
